# Copy this file to .env and fill in real values before `docker compose up`.
# .env is gitignored — never commit it.
#
# Every variable below is required: web's instrumentation.ts and server's
# main.cpp both fail fast at startup (refuse to bind any port, print which
# variable is missing) if any of these are unset or empty. There are no
# fallback defaults, so the process will not silently run in a
# half-configured state. For the key each service actually reads —
# SESSION_JWT_PRIVATE_KEY_PATH on web, AUTH_JWT_PUBLIC_KEY_PATH on server —
# "present" isn't enough either: both also verify the file it points to
# actually exists and is readable before finishing startup (i.e. that
# secrets/*.pem got bind-mounted correctly, not just that the path string
# itself is non-empty). web is also given AUTH_JWT_PUBLIC_KEY_PATH for
# parity with server's mount, but doesn't read it today.

# Postgres credentials, used by both the postgres service and web's
# DATABASE_URL (docker-compose.yml constructs the connection string from
# these three).
POSTGRES_USER=cig_nexus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cig_nexus

# Discord OAuth2 app credentials. Create an app at
# https://discord.com/developers/applications and add
# http://localhost:3000/api/auth/discord/callback as a redirect URI.
# Required — web will not start without these.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# RS256 keypair for the application session JWT (docs/auth-discord-design.md
# §6) — kept as real files under secrets/ (gitignored, like .env) rather
# than inlined here, and bind-mounted read-only into the containers by
# docker-compose.yml. These two vars are just the in-container path each
# service reads the key from, not the key material itself — the paths
# below are also what docker-compose.yml mounts the files to, so change
# both together if you ever do change them. Generate the keypair with:
#   mkdir -p secrets
#   openssl genrsa -out /tmp/rsa.pem 2048
#   openssl pkcs8 -topk8 -nocrypt -in /tmp/rsa.pem -out secrets/private.pem
#   openssl rsa -in /tmp/rsa.pem -pubout -out secrets/public.pem
#   rm /tmp/rsa.pem
#   chmod 600 secrets/private.pem
# The last step isn't cosmetic: web's instrumentation.ts and server's
# main.cpp both now refuse to start if secrets/private.pem is group- or
# world-readable (docs/security-audit.md §1.3). OpenSSL's pkcs8 output
# already defaults to 0600 on most systems, but this makes it explicit
# rather than relying on that default.
SESSION_JWT_PRIVATE_KEY_PATH=/run/secrets/private.pem
AUTH_JWT_PUBLIC_KEY_PATH=/run/secrets/public.pem

# Random secrets — generate each with `openssl rand -hex 32`.
# OAUTH_TXN_SECRET signs the short-lived OAuth state/PKCE cookie (web only).
# INTERNAL_API_SHARED_SECRET authenticates server's calls to web's internal
# catalog API (docs/auth-discord-design.md §8.1/§9.1) — same value on both
# sides.
OAUTH_TXN_SECRET=
INTERNAL_API_SHARED_SECRET=
